[Unit]
Description=CitrusPi Monitoring Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/citruspi
Environment=PYTHONPATH=/home/pi/citruspi/src
ExecStart=/home/pi/citruspi/.venv/bin/python -m citruspi
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Allow binding to privileged ports (< 1024) such as port 80 as non-root user
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
