[Unit]
Description=CitrusPi Monitoring Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/citruspi
ExecStart=/home/pi/citruspi/.venv/bin/python -m citruspi
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
